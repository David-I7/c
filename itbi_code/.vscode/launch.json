{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Static Launch GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/a.out",
      "args": ["eum iure","substr.txt"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
        "text": "set follow-fork-mode child"
    },
    {
        "text": "set detach-on-fork off"
    }
      ]
    }
]}